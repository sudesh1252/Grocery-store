# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shree_grocery
DB_USER=root
DB_PASSWORD=root

# Alternative: Full connection string
# DB_URL=mysql://root:password@localhost:3306/shree_grocery

# JWT Configuration
# IMPORTANT: Change this secret key in production!
JWT_SECRET=shree_grocery_super_secret_key_2026_change_in_production
JWT_EXPIRE=7d

# CORS Configuration (Frontend URL)
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email Configuration for Password Reset
# IMPORTANT: Replace with your actual Gmail credentials
# For Gmail: You need to use an "App Password" not your regular password
# 1. Go to Google Account Settings > Security
# 2. Enable 2-Step Verification
# 3. Generate an "App Password" for Mail
# 4. Use that app password below
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=kirolkarsudesh06@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_FROM=kirolkarsudesh06@gmail.com
EMAIL_FROM_NAME=Shree Grocery Store
